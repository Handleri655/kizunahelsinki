---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { localePath } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="fi"
  route="home"
  title="Sivua ei löydy | Ravintola KIZUNA"
  description="Tätä osoitetta ei ole."
  noindex
>
  <div class="mx-auto max-w-3xl px-5 py-24">
    <Image src={mark} alt="" width={96} height={92} class="mb-8 h-24 w-24 object-contain" />
    <p class="kicker">404</p>
    <h1 class="mt-3 font-serif text-5xl">Sivua ei löydy</h1>
    <p class="mt-4 text-ink-soft">Page not found · ページが見つかりません</p>
    <p class="mt-6">Tätä osoitetta ei ole. Ruoka on edelleen Pursimiehenkadulla.</p>
    <ul class="mt-8 space-y-2">
      <li><a href={localePath('fi', 'home')}>Suomeksi</a></li>
      <li><a href={localePath('en', 'home')}>In English</a></li>
      <li><a href={localePath('ja', 'home')}>日本語</a></li>
    </ul>
  </div>
</BaseLayout>
