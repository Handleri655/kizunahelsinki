---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { restaurant } from '../data/restaurant';
import { copy } from '../i18n/copy';
import { localeLabels, localePath, locales, type Lang, type RouteId } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: RouteId;
}

const { lang, route } = Astro.props;
const t = copy[lang];
const links: { id: RouteId; label: string }[] = [
  { id: 'menu', label: t.navMenu },
  { id: 'story', label: t.navStory },
  { id: 'school', label: t.navSchool },
  { id: 'reserve', label: t.navReserve },
  { id: 'contact', label: t.navContact },
];
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href={localePath(lang, 'home')} class="group flex items-center gap-3 no-underline">
      <Image src={mark} alt="" width={46} height={44} class="h-11 w-11 object-contain" />
      <span class="font-serif text-lg tracking-[0.18em] text-ink">KIZUNA</span>
    </a>
    <nav aria-label={t.navPrimary} class="hidden items-center gap-6 md:flex">
      {
        links.map((link) => {
          const href = localePath(lang, link.id);
          const current = route === link.id;
          return (
            <a
              href={href}
              aria-current={current ? 'page' : undefined}
              class:list={['no-underline', current ? 'text-accent' : 'text-ink-soft hover:text-ink']}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
    <div class="flex items-center gap-3">
      <nav aria-label={t.langLabel} class="hidden items-center gap-2 text-sm md:flex">
        {
          locales.map((locale) => (
            <a
              href={localePath(locale, route)}
              hrefLang={locale}
              lang={locale}
              aria-current={locale === lang ? 'true' : undefined}
              class:list={[
                'no-underline',
                locale === lang ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              {localeLabels[locale]}
            </a>
          ))
        }
      </nav>
      <a class="btn-ghost hidden md:inline-flex" href={restaurant.wolt} target="_blank" rel="noopener noreferrer">
        {t.ctaOrder}
        <span class="sr-only">({t.ctaOrderOpens})</span>
      </a>
      <a class="btn hidden md:inline-flex" href={localePath(lang, 'reserve')}>{t.ctaReserve}</a>
    </div>
  </div>
  <div class="nav-scroll flex items-center gap-4 overflow-x-auto px-5 pb-2.5 md:hidden">
    <nav aria-label={t.navPrimary} class="flex items-center gap-4">
    {
      links.map((link) => (
        <a
          href={localePath(lang, link.id)}
          aria-current={route === link.id ? 'page' : undefined}
          class:list={[
            'shrink-0 border-b-2 py-1 no-underline',
            route === link.id ? 'border-accent text-accent' : 'border-transparent text-ink-soft',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    </nav>
    <nav aria-label={t.langLabel} class="ml-auto flex shrink-0 items-center gap-2.5 pl-3 text-sm">
      {
        locales.map((locale) => (
          <a
            href={localePath(locale, route)}
            hrefLang={locale}
            lang={locale}
            aria-current={locale === lang ? 'true' : undefined}
            class:list={['no-underline', locale === lang ? 'text-ink' : 'text-muted']}
          >
            <span class="sr-only">{localeLabels[locale]}</span>
            <span aria-hidden="true">{locale === 'ja' ? '日' : locale.toUpperCase()}</span>
          </a>
        ))
      }
    </nav>
  </div>
</header>
