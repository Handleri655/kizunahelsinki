---
import { restaurant } from '../data/restaurant';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const topics = [
  { value: 'general', label: t.formTopicGeneral },
  { value: 'group', label: t.formTopicGroup },
  { value: 'gift', label: t.formTopicGift },
  { value: 'other', label: t.formTopicOther },
];
const messages = {
  required: t.formRequired,
  email: t.formEmailInvalid,
  short: t.formMessageShort,
  success: t.formSuccess,
  labels: {
    name: t.formName,
    email: t.formEmail,
    phone: t.formPhone,
    topic: t.formTopic,
  },
};
---

<section id="yhteydenotto" class="mt-16 border-t border-line pt-14" aria-labelledby="contact-form-title">
  <p class="kicker">{t.formKicker}</p>
  <h2 id="contact-form-title" class="mt-3 font-serif text-4xl">{t.formTitle}</h2>
  <p class="mt-4 max-w-2xl text-ink-soft">{t.formIntro}</p>
  <form class="mt-8 max-w-2xl" novalidate data-contact-form data-email={restaurant.email}>
    <p class="text-sm text-muted">{t.formRequiredNote}</p>
    <div class="mt-6 grid gap-5">
      <div>
        <label class="mb-2 block" for="contact-name">
          {t.formName} <span aria-hidden="true">*</span>
        </label>
        <input
          class="field"
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="80"
        />
        <p id="contact-name-error" class="mt-2 text-sm text-accent" hidden></p>
      </div>
      <div>
        <label class="mb-2 block" for="contact-email">
          {t.formEmail} <span aria-hidden="true">*</span>
        </label>
        <input
          class="field"
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          maxlength="120"
        />
        <p id="contact-email-error" class="mt-2 text-sm text-accent" hidden></p>
      </div>
      <div>
        <label class="mb-2 block" for="contact-phone">
          {t.formPhone}{' '}
          <span class="text-muted">({t.formOptional})</span>
        </label>
        <input
          class="field"
          id="contact-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          maxlength="40"
        />
      </div>
      <div>
        <label class="mb-2 block" for="contact-topic">
          {t.formTopic} <span aria-hidden="true">*</span>
        </label>
        <select class="field" id="contact-topic" name="topic" required>
          <option value="">{t.formTopicPlaceholder}</option>
          {topics.map((topic) => <option value={topic.label}>{topic.label}</option>)}
        </select>
        <p id="contact-topic-error" class="mt-2 text-sm text-accent" hidden></p>
      </div>
      <div>
        <label class="mb-2 block" for="contact-message">
          {t.formMessage} <span aria-hidden="true">*</span>
        </label>
        <textarea class="field" id="contact-message" name="message" required maxlength="2000"></textarea>
        <p id="contact-message-error" class="mt-2 text-sm text-accent" hidden></p>
      </div>
    </div>
    <p class="mt-6" role="status" data-form-success hidden></p>
    <p class="mt-6">
      <button class="btn" type="submit">{t.formSubmit}</button>
    </p>
    <script type="application/json" data-form-copy set:html={JSON.stringify(messages)} />
  </form>
</section>

<script>
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const copyNode = form.querySelector('[data-form-copy]');
    if (!copyNode?.textContent) return;
    const messages = JSON.parse(copyNode.textContent) as {
      required: string;
      email: string;
      short: string;
      success: string;
      labels: { name: string; email: string; phone: string; topic: string };
    };
    const success = form.querySelector<HTMLElement>('[data-form-success]');

    const clear = (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      input.removeAttribute('aria-invalid');
      const error = form.querySelector<HTMLElement>(`#${input.id}-error`);
      if (!error) return;
      error.hidden = true;
      error.textContent = '';
    };

    const fail = (
      input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
      message: string,
    ) => {
      const error = form.querySelector<HTMLElement>(`#${input.id}-error`);
      input.setAttribute('aria-invalid', 'true');
      if (!error) return;
      error.hidden = false;
      error.textContent = message;
      input.setAttribute('aria-describedby', error.id);
    };

    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((input) => {
      input.addEventListener('input', () => clear(input));
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (success) success.hidden = true;

      const name = form.querySelector<HTMLInputElement>('#contact-name');
      const email = form.querySelector<HTMLInputElement>('#contact-email');
      const phone = form.querySelector<HTMLInputElement>('#contact-phone');
      const topic = form.querySelector<HTMLSelectElement>('#contact-topic');
      const message = form.querySelector<HTMLTextAreaElement>('#contact-message');
      if (!name || !email || !phone || !topic || !message) return;

      [name, email, topic, message].forEach(clear);
      let firstInvalid: HTMLElement | null = null;

      const mark = (
        input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
        text: string,
      ) => {
        fail(input, text);
        firstInvalid ??= input;
      };

      if (name.value.trim().length < 2) mark(name, messages.required);
      if (!emailPattern.test(email.value.trim())) mark(email, messages.email);
      if (!topic.value) mark(topic, messages.required);
      if (message.value.trim().length < 8) mark(message, messages.short);

      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const recipient = form.dataset.email ?? '';
      const body = [
        `${messages.labels.name}: ${name.value.trim()}`,
        `${messages.labels.email}: ${email.value.trim()}`,
        phone.value.trim() ? `${messages.labels.phone}: ${phone.value.trim()}` : '',
        `${messages.labels.topic}: ${topic.value}`,
        '',
        message.value.trim(),
      ]
        .filter((line) => line !== '')
        .join('\n');
      const href = `mailto:${recipient}?subject=${encodeURIComponent(topic.value)}&body=${encodeURIComponent(body)}`;
      if (success) {
        success.hidden = false;
        success.replaceChildren(document.createTextNode(`${messages.success} `));
        const link = document.createElement('a');
        link.href = `mailto:${recipient}`;
        link.textContent = recipient;
        success.append(link);
      }
      window.location.href = href;
    });
  });
</script>
