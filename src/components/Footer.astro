---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { restaurant } from '../data/restaurant';
import { copy } from '../i18n/copy';
import { localePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<footer class="border-t border-line bg-paper-deep">
  <div class="mx-auto grid max-w-6xl gap-6 px-5 py-8 md:grid-cols-3 md:gap-8 md:py-12">
    <div>
      <div class="flex items-center gap-3">
        <Image src={mark} alt="" width={42} height={40} class="h-10 w-10 object-contain" />
        <p class="font-serif text-2xl tracking-[0.16em]">KIZUNA</p>
      </div>
      <p class="mt-2 text-muted">{t.footerBond}</p>
    </div>
    <div>
      <p class="text-sm text-muted">{t.addressHeading}</p>
      <p class="mt-2">
        {restaurant.street}<br />
        {restaurant.postalCode} {restaurant.city}
      </p>
    </div>
    <div>
      <p class="text-sm text-muted">{t.contactHeading}</p>
      <p class="mt-2">
        <a href={`tel:${restaurant.phoneTel}`}>{restaurant.phoneDisplay}</a><br />
        <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a><br />
        <a href={restaurant.instagram} rel="noopener noreferrer">{restaurant.instagramHandle}</a>
      </p>
    </div>
  </div>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 pb-28 text-sm text-muted md:pb-8">
    <p>© {new Date().getFullYear()} {restaurant.name}</p>
    <a class="hidden md:inline" href={localePath(lang, 'reserve')}>{t.ctaReserve}</a>
  </div>
</footer>
