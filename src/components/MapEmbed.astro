---
import { restaurant } from '../data/restaurant';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<figure>
  <iframe
    class="h-80 w-full border border-line md:h-[28rem]"
    title={t.contactMapTitle}
    src={`${restaurant.mapsEmbed}&hl=${lang}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <figcaption class="mt-3">
    <a href={restaurant.maps} rel="noopener noreferrer">{t.ctaMap}</a>
  </figcaption>
</figure>
