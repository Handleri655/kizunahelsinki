---
import GiftCardForm from '../GiftCardForm.astro';
import { restaurant } from '../../data/restaurant';
import { copy } from '../../i18n/copy';
import type { Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<BaseLayout lang={lang} route="gift" title={t.seoGiftTitle} description={t.seoGiftDescription}>
  <div class="mx-auto max-w-5xl px-5 py-8 md:py-16">
    <p class="kicker">{t.giftKicker}</p>
    <h1 class="mt-3 font-serif text-4xl md:text-6xl">{t.giftTitle}</h1>
    <p class="mt-6 max-w-2xl font-serif text-2xl text-ink-soft md:text-3xl">{t.giftPageLead}</p>
    <ol class="mt-8 max-w-2xl list-decimal space-y-2 pl-5 text-ink-soft">
      {t.giftSteps.map((step) => <li>{step}</li>)}
    </ol>
    <h2 class="mt-10 font-serif text-2xl">{t.giftInStore}</h2>
    <p class="mt-4">
      {restaurant.street}<br />
      {restaurant.postalCode} {restaurant.city}
    </p>
    <ul class="mt-3 space-y-1">
      <li>{t.hoursWeek}</li>
      <li>{t.hoursSat}</li>
      <li>{t.hoursSun}</li>
    </ul>
    <p class="mt-4">
      <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a><br />
      <a href={`tel:${restaurant.phoneTel}`}>{restaurant.phoneDisplay}</a>
    </p>
    <GiftCardForm lang={lang} />
  </div>
</BaseLayout>
