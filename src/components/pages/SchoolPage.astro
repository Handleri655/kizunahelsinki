---
import { Image } from 'astro:assets';
import flyer from '../../assets/brand/sushi-school-card.png';
import ContactForm from '../ContactForm.astro';
import { restaurant } from '../../data/restaurant';
import { copy } from '../../i18n/copy';
import type { Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const highlights = [t.schoolDuration, t.schoolPrice, t.schoolIncludes, t.schoolMinimum];
const mailto = `mailto:${restaurant.email}?subject=${encodeURIComponent(t.navSchool)}`;
---

<BaseLayout lang={lang} route="school" title={t.seoSchoolTitle} description={t.seoSchoolDescription}>
  <div class="mx-auto max-w-5xl px-5 py-8 md:py-16">
  <div class="grid items-start gap-8 md:grid-cols-[1.1fr_0.9fr] md:gap-12">
    <div>
      <p class="kicker" lang="ja">寿司教室</p>
      <h1 class="mt-3 font-serif text-4xl md:text-6xl">{t.navSchool}</h1>
      <p class="mt-6 font-serif text-2xl text-ink-soft md:text-3xl">{t.schoolLead}</p>
      <p class="mt-5 text-ink-soft">{t.schoolBody}</p>
      <h2 class="mt-10 font-serif text-2xl">{t.schoolHighlights}</h2>
      <ul class="mt-4 space-y-2">
        {highlights.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-8">
        <a class="btn w-full sm:w-auto" href={mailto}>{t.schoolBook}</a>
      </p>
      <p class="mt-4 text-sm text-muted">{t.schoolBookNote}</p>
      <p class="mt-4">
        <a href={mailto}>{restaurant.email}</a><br />
        <a href={`tel:${restaurant.phoneTel}`}>{restaurant.phoneDisplay}</a>
      </p>
    </div>
    <Image
      src={flyer}
      alt={t.schoolImageAlt}
      widths={[480, 720, 900]}
      sizes="(min-width: 768px) 36vw, 100vw"
      quality={82}
      class="w-full border border-line"
    />
  </div>
  <ContactForm lang={lang} />
  </div>
</BaseLayout>
