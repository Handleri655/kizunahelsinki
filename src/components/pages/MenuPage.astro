---
import MenuBoard from '../MenuBoard.astro';
import { restaurant } from '../../data/restaurant';
import { copy } from '../../i18n/copy';
import type { Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<BaseLayout lang={lang} route="menu" title={t.seoMenuTitle} description={t.seoMenuDescription}>
  <div class="mx-auto max-w-6xl px-5 py-8 md:py-14">
    <p class="kicker">{t.menuKicker}</p>
    <h1 class="mt-3 font-serif text-4xl md:text-6xl">{t.menuTitle}</h1>
    <p class="mt-5 max-w-3xl text-ink-soft">{t.menuIntro}</p>
    <p class="mt-6">
      <a class="btn w-full sm:w-auto" href={restaurant.wolt} target="_blank" rel="noopener noreferrer">
        {t.ctaOrder}
        <span class="sr-only">({t.ctaOrderOpens})</span>
      </a>
    </p>
    <div class="mt-8">
      <MenuBoard lang={lang} />
    </div>
    <div class="mt-16 max-w-3xl space-y-4 border-t border-line pt-8 text-sm text-ink-soft">
      <p>{t.menuDisclaimer}</p>
      <p>{t.menuMarkL}</p>
      <p>{t.menuPayment}</p>
      <p>{t.menuCourseNote}</p>
    </div>
  </div>
</BaseLayout>
