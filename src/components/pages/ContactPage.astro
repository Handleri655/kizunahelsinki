---
import MapEmbed from '../MapEmbed.astro';
import { restaurant } from '../../data/restaurant';
import { copy } from '../../i18n/copy';
import type { Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<BaseLayout lang={lang} route="contact" title={t.seoContactTitle} description={t.seoContactDescription}>
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 md:grid-cols-2">
    <div>
      <p class="kicker">{t.contactKicker}</p>
      <h1 class="mt-3 font-serif text-5xl md:text-6xl">{t.contactTitle}</h1>
      <address class="mt-8 not-italic">
        <p>
          {restaurant.name}<br />
          {restaurant.street}<br />
          {restaurant.postalCode} {restaurant.city}
        </p>
        <p class="mt-4">
          <a href={`tel:${restaurant.phoneTel}`}>{restaurant.phoneDisplay}</a><br />
          <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a>
        </p>
      </address>
      <h2 class="mt-10 font-serif text-2xl">{t.hoursHeading}</h2>
      <ul class="mt-3 space-y-1">
        <li>{t.hoursWeek}</li>
        <li>{t.hoursSat}</li>
        <li>{t.hoursSun}</li>
        <li class="text-muted">{t.hoursLast}</li>
      </ul>
      <h2 class="mt-10 font-serif text-2xl">{t.ctaRoute}</h2>
      <p class="mt-3 text-ink-soft">{t.visitDirections}</p>
      <p class="mt-4">
        <a href={restaurant.mapsDirections}>{t.ctaRoute}</a>
      </p>
    </div>
    <div>
      <MapEmbed lang={lang} />
    </div>
  </div>
</BaseLayout>
