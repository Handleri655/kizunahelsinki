---
import { Image } from 'astro:assets';
import mark from '../../assets/brand/mark.png';
import { copy } from '../../i18n/copy';
import { localePath, type Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<BaseLayout lang={lang} route="story" title={t.seoStoryTitle} description={t.seoStoryDescription}>
  <article class="mx-auto max-w-3xl px-5 py-8 md:py-16">
    <p class="kicker">{t.storyKicker}</p>
    <h1 class="mt-3 font-serif text-4xl md:text-6xl">{t.storyTitle}</h1>
    <div class="mt-10 space-y-6 text-lg text-ink-soft">
      <p>{t.storyP1}</p>
      <p>{t.storyP2}</p>
      <p>{t.storyP3}</p>
      <p>{t.storyP4}</p>
    </div>
    <section class="mt-16 border-t border-line pt-10">
      <Image
        src={mark}
        alt={t.storyLogoAlt}
        widths={[320, 480, 720]}
        sizes="(min-width: 768px) 16rem, 70vw"
        class="mb-8 w-full max-w-xs"
      />
      <p class="kicker">{t.kamomeKicker}</p>
      <h2 class="mt-3 font-serif text-4xl">{t.storyKamomeTitle}</h2>
      <p class="mt-5 text-lg text-ink-soft">{t.storyKamome}</p>
    </section>
    <p class="mt-12 font-serif text-3xl">{t.storyWelcome}</p>
    <p class="mt-8">
      <a class="btn" href={localePath(lang, 'reserve')}>{t.ctaReserve}</a>
    </p>
  </article>
</BaseLayout>
