---
import { restaurant } from '../../data/restaurant';
import { copy } from '../../i18n/copy';
import type { Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<BaseLayout lang={lang} route="reserve" title={t.seoReserveTitle} description={t.seoReserveDescription}>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <p class="kicker">{t.reserveKicker}</p>
    <h1 class="mt-3 font-serif text-5xl md:text-6xl">{t.reserveTitle}</h1>
    <p class="mt-6 text-lg text-ink-soft">{t.reserveBody}</p>
    <p class="mt-8">
      <a class="btn" href={restaurant.reservation} rel="noopener noreferrer">
        {t.reserveBook}
        <span class="sr-only">({t.reserveOpens})</span>
      </a>
    </p>
    <p class="mt-4 text-sm text-muted">{t.reserveOpens}</p>
    <section class="mt-12 border border-line bg-foam p-6">
      <h2 class="font-serif text-2xl">{t.contactHeading}</h2>
      <p class="mt-3">
        <a href={`tel:${restaurant.phoneTel}`}>{restaurant.phoneDisplay}</a>
      </p>
      <p class="mt-2">
        <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a>
      </p>
    </section>
    <section class="mt-10">
      <h2 class="font-serif text-2xl">{t.reserveGroupTitle}</h2>
      <p class="mt-3 text-ink-soft">{t.reserveGroup}</p>
    </section>
    <p class="mt-10 text-sm text-muted">{t.menuPayment}</p>
  </div>
</BaseLayout>
