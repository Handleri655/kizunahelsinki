---
import { Image } from 'astro:assets';
import atmosphere from '../../assets/placeholder/atmosphere.png';
import JsonLd from '../JsonLd.astro';
import OpenStatus from '../OpenStatus.astro';
import { restaurant } from '../../data/restaurant';
import { copy } from '../../i18n/copy';
import { localePath, type Lang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const dishes = [
  { kanji: '寿司', title: t.dishSushiTitle, body: t.dishSushiBody },
  { kanji: '麺', title: t.dishRamenTitle, body: t.dishRamenBody },
  { kanji: '焼鳥', title: t.dishYakitoriTitle, body: t.dishYakitoriBody },
  { kanji: '鰻', title: t.dishUnagiTitle, body: t.dishUnagiBody },
  { kanji: '豆腐', title: t.dishTofuTitle, body: t.dishTofuBody },
];
---

<BaseLayout lang={lang} route="home" title={t.seoHomeTitle} description={t.seoHomeDescription}>
  <JsonLd lang={lang} />
  <section class="mx-auto grid max-w-6xl items-end gap-10 px-5 py-16 md:grid-cols-[1.4fr_0.8fr] md:py-24">
    <div>
      <p class="kicker">{t.heroEyebrow}</p>
      <h1 class="mt-4 font-serif text-6xl tracking-wide text-ink md:text-8xl">Kizuna</h1>
      <p class="mt-6 max-w-xl font-serif text-3xl text-ink-soft md:text-4xl">{t.heroLead}</p>
      <p class="mt-5 max-w-xl text-ink-soft">{t.heroSub}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn" href={localePath(lang, 'reserve')}>{t.ctaReserve}</a>
        <a class="btn-ghost" href={localePath(lang, 'menu')}>{t.ctaMenu}</a>
      </div>
      <div class="mt-8">
        <OpenStatus lang={lang} />
      </div>
    </div>
    <div class="relative">
      <Image
        src={atmosphere}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 36vw, 100vw"
        class="aspect-[4/5] w-full object-cover"
        loading="eager"
      />
      <p class="pointer-events-none absolute right-4 bottom-4 font-serif text-5xl text-paper" aria-hidden="true">絆</p>
    </div>
  </section>

  <section class="border-y border-line bg-foam" aria-label={t.hoursHeading}>
    <dl class="mx-auto grid max-w-6xl gap-8 px-5 py-10 md:grid-cols-3">
      <div>
        <dt class="text-sm text-muted">{t.addressHeading}</dt>
        <dd class="mt-2">
          {restaurant.street}<br />
          {restaurant.postalCode} {restaurant.city}
        </dd>
      </div>
      <div>
        <dt class="text-sm text-muted">{t.hoursHeading}</dt>
        <dd class="mt-2">
          {t.hoursWeek}<br />
          {t.hoursSat}<br />
          {t.hoursSun}<br />
          <span class="text-muted">{t.hoursLast}</span>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-muted">{t.contactHeading}</dt>
        <dd class="mt-2">
          <a href={`tel:${restaurant.phoneTel}`}>{restaurant.phoneDisplay}</a><br />
          <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-5 py-20 md:grid-cols-[0.8fr_1.2fr]">
    <div class="reveal">
      <p class="kicker">{t.introKicker}</p>
      <h2 class="mt-3 font-serif text-4xl md:text-5xl">{t.introTitle}</h2>
    </div>
    <div class="reveal">
      <p class="text-lg text-ink-soft">{t.introBody}</p>
      <p class="mt-6 font-serif text-2xl">{t.introQuote}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20">
    <p class="kicker">{t.dishesKicker}</p>
    <h2 class="mt-3 font-serif text-4xl">{t.dishesTitle}</h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        dishes.map((dish) => (
          <li class="reveal border border-line bg-foam p-5">
            <p class="font-serif text-3xl text-accent" lang="ja">
              {dish.kanji}
            </p>
            <h3 class="mt-4 font-serif text-2xl">{dish.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{dish.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a href={localePath(lang, 'menu')}>{t.ctaMenu}</a>
    </p>
  </section>

  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-20 md:grid-cols-[1fr_1fr] md:items-center">
      <div>
        <p class="text-sm tracking-[0.22em] text-paper/70">{t.kamomeKicker}</p>
        <h2 class="mt-3 font-serif text-4xl md:text-5xl">{t.kamomeTitle}</h2>
        <p class="mt-5 text-paper/85">{t.kamomeBody}</p>
        <p class="mt-8">
          <a class="btn bg-paper text-ink hover:bg-paper-deep" href={localePath(lang, 'story')}>{t.kamomeLink}</a>
        </p>
      </div>
      <p class="font-serif text-7xl leading-none md:text-8xl" lang="ja">かもめ食堂</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-20 md:grid-cols-2">
    <div class="reveal border border-line p-8">
      <p class="kicker">{t.instagramKicker}</p>
      <h2 class="mt-3 font-serif text-3xl">{t.instagramTitle}</h2>
      <p class="mt-4 text-ink-soft">{t.instagramBody}</p>
      <p class="mt-6">
        <a href={restaurant.instagram} rel="noopener noreferrer">{restaurant.instagramHandle}</a>
      </p>
    </div>
    <div class="reveal border border-line p-8">
      <p class="kicker">{t.visitKicker}</p>
      <h2 class="mt-3 font-serif text-3xl">{t.visitTitle}</h2>
      <p class="mt-4 text-ink-soft">{t.visitDirections}</p>
      <p class="mt-6 flex flex-wrap gap-4">
        <a href={localePath(lang, 'contact')}>{t.navContact}</a>
        <a href={restaurant.mapsDirections}>{t.ctaRoute}</a>
      </p>
    </div>
  </section>
</BaseLayout>
