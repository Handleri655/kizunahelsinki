---
import { restaurant } from '../data/restaurant';
import { copy } from '../i18n/copy';
import { localePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const icon = 'h-5 w-5';
---

<nav aria-label={t.navMobile} class="mobile-bar md:hidden">
  <a href={localePath(lang, 'reserve')}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <rect x="4" y="5" width="16" height="15" rx="1.5"></rect>
      <path d="M8 3.5v3M16 3.5v3M4 9.5h16"></path>
    </svg>
    {t.navReserve}
  </a>
  <a href={restaurant.wolt} target="_blank" rel="noopener noreferrer">
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M6 8h12l-1 11H7L6 8z"></path>
      <path d="M9 8V7a3 3 0 0 1 6 0v1"></path>
    </svg>
    {t.ctaOrder}
  </a>
  <a href={`tel:${restaurant.phoneTel}`}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M8 4.5h2.2l1.2 3-1.6 1a12 12 0 0 0 5.7 5.7l1-1.6 3 1.2V17a1.5 1.5 0 0 1-1.6 1.5A14.5 14.5 0 0 1 6.5 6.1 1.5 1.5 0 0 1 8 4.5z"></path>
    </svg>
    {t.ctaCall}
  </a>
  <a href={restaurant.mapsDirections}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M12 21s6-5.4 6-10a6 6 0 1 0-12 0c0 4.6 6 10 6 10z"></path>
      <circle cx="12" cy="11" r="2"></circle>
    </svg>
    {t.ctaRoute}
  </a>
</nav>
